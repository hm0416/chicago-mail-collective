# Server-side only. Add these as Netlify environment variables; never put them in the browser code.
# Stripe (card payments)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Resend (emails you when someone pays)
# RESEND_API_KEY=re_...
# NOTIFY_EMAIL=hifamousou@gmail.com
# Subscriber archive (paywall)
# SUBSCRIBER_CODE=pick-a-code
# ISSUE_1_PDF=https://...
# ISSUE_2_PDF=https://...
