diff --git a/README.md b/README.md
index b25b3c7..d2074bc 100644
--- a/README.md
+++ b/README.md
@@ -12,7 +12,15 @@ React (Vite) + React Router. Pages: Home, About, Community & Artists, Subscribe,
 2. In Site settings → Environment variables, add the values from `.env.example`.
 
 ## Make the pieces real
-- **Sign-ups:** create a free form at formspree.io, paste its URL into `VITE_FORM_ENDPOINT`. Each sign-up (name, email, address) is emailed to you. Without it, the form opens an email to you instead.
-- **Venmo:** set `VITE_VENMO_HANDLE`. Payments are manual: when a Venmo payment arrives, add the person to your mailing list. Venmo has no recurring-payment tool, so ask subscribers to send $10 every other month (or switch to Stripe later).
 - **Paywall:** set `SUBSCRIBER_CODE` and `ISSUE_1_PDF`, `ISSUE_2_PDF` (links to the PDFs) as Netlify environment variables. The code is checked on the server (`netlify/functions/archive.js`), and the PDF links are only sent after it's right. Give the code to subscribers. Note: the story excerpts on the issue pages are public; only the PDFs are protected. Host the PDFs somewhere private, not linked elsewhere.
 - **Placeholders to fill in:** Instagram handle (`.env`), Issue 1 date and the artist credits (`src/data.js`, `src/pages/Community.jsx`), Douglas Tsui's bio, sliding-scale tiers (`src/pages/Subscribe.jsx`), how contributors are paid (`src/pages/Community.jsx`).
+
+## Stripe (how people pay)
+Subscribers pay by card on Stripe's checkout page. Card subscribers are charged $10 every 2 months, and you get an email at hifamousou@gmail.com only after Stripe confirms the payment.
+1. Create a Stripe account (stripe.com). Stay in **Test mode** first.
+2. Developers → API keys: copy the **Secret key** into Netlify as `STRIPE_SECRET_KEY`.
+3. Developers → Webhooks → Add endpoint: URL `https://YOUR-SITE.netlify.app/.netlify/functions/stripe-webhook`, event `checkout.session.completed`. Copy its **Signing secret** into Netlify as `STRIPE_WEBHOOK_SECRET`.
+4. Sign up at resend.com **with hifamousou@gmail.com**, create an API key, and add it as `RESEND_API_KEY`. (Resend's free starter sender only delivers to the email you signed up with. To send elsewhere, verify a domain.)
+5. Redeploy (Deploys → Trigger deploy). Test with card `4242 4242 4242 4242`, any future date, any CVC.
+6. When it works, switch Stripe to **Live mode** and replace the two Stripe keys with the live ones.
+To let subscribers cancel, turn on the Customer portal in Stripe (Settings → Billing → Customer portal).
diff --git a/netlify/functions/create-checkout.js b/netlify/functions/create-checkout.js
new file mode 100644
index 0000000..20bb2ac
--- /dev/null
+++ b/netlify/functions/create-checkout.js
@@ -0,0 +1,36 @@
+// Creates a Stripe Checkout session for a recurring $10 / every-2-months subscription.
+import Stripe from 'stripe'
+
+export default async (req) => {
+  if (req.method !== 'POST') return new Response('Method not allowed', { status: 405 })
+  const stripe = new Stripe(process.env.STRIPE_SECRET_KEY)
+  let b
+  try { b = await req.json() } catch { return Response.json({ error: 'bad request' }, { status: 400 }) }
+  if (!b.email || !b.first || !b.last || !b.a1 || !b.city || !b.st || !b.zip) {
+    return Response.json({ error: 'missing fields' }, { status: 400 })
+  }
+  const origin = process.env.URL || new URL(req.url).origin
+  try {
+    const session = await stripe.checkout.sessions.create({
+      mode: 'subscription',
+      customer_email: b.email,
+      line_items: [{
+        quantity: 1,
+        price_data: {
+          currency: 'usd',
+          unit_amount: 1000,
+          recurring: { interval: 'month', interval_count: 2 },
+          product_data: { name: 'Chicago Mail Collective: printed issue every other month' },
+        },
+      }],
+      metadata: { name: `${b.first} ${b.last}`, address: b.address || '' },
+      subscription_data: { metadata: { name: `${b.first} ${b.last}`, address: b.address || '' } },
+      success_url: `${origin}/subscribe/success`,
+      cancel_url: `${origin}/subscribe`,
+    })
+    return Response.json({ url: session.url })
+  } catch (err) {
+    console.error(err)
+    return Response.json({ error: 'stripe error' }, { status: 500 })
+  }
+}
diff --git a/netlify/functions/stripe-webhook.js b/netlify/functions/stripe-webhook.js
new file mode 100644
index 0000000..102626d
--- /dev/null
+++ b/netlify/functions/stripe-webhook.js
@@ -0,0 +1,34 @@
+// Stripe calls this after a payment. A subscriber only counts once Stripe says they paid.
+import Stripe from 'stripe'
+
+export default async (req) => {
+  const stripe = new Stripe(process.env.STRIPE_SECRET_KEY)
+  const raw = await req.text()
+  let event
+  try {
+    event = stripe.webhooks.constructEvent(raw, req.headers.get('stripe-signature'), process.env.STRIPE_WEBHOOK_SECRET)
+  } catch {
+    return new Response('Bad signature', { status: 400 })
+  }
+
+  if (event.type === 'checkout.session.completed' && event.data.object.payment_status === 'paid') {
+    const s = event.data.object
+    const to = process.env.NOTIFY_EMAIL || 'hifamousou@gmail.com'
+    const text = [
+      'New paid subscriber for the Chicago Mail Collective.',
+      '',
+      `Name: ${s.metadata?.name || ''}`,
+      `Email: ${s.customer_details?.email || s.customer_email || ''}`,
+      `Mailing address: ${s.metadata?.address || ''}`,
+      `Paid: $${(s.amount_total / 100).toFixed(2)} (recurring every 2 months)`,
+      `Stripe payment: ${s.id}`,
+    ].join('\n')
+    const r = await fetch('https://api.resend.com/emails', {
+      method: 'POST',
+      headers: { Authorization: `Bearer ${process.env.RESEND_API_KEY}`, 'Content-Type': 'application/json' },
+      body: JSON.stringify({ from: 'Chicago Mail Collective <onboarding@resend.dev>', to: [to], subject: `New paid subscriber: ${s.metadata?.name || ''}`, text }),
+    })
+    if (!r.ok) return new Response('Email failed', { status: 500 }) // Stripe will retry
+  }
+  return new Response('ok')
+}
